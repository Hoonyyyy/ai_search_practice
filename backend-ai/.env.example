# ── 로컬 스택 (기본값이 이미 로컬용이라 .env 없이도 동작) ──────────
# 값을 바꾸고 싶을 때만 아래 주석을 풀어 사용한다.

# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:3b          # 더 빠르게: qwen2.5:1.5b / 더 좋게: qwen2.5:7b
# EMBED_MODEL=bge-m3            # 768d nomic-embed-text 로 바꾸면 EMBED_DIM=768 도 같이
# EMBED_DIM=1024
# TOP_K=4
# OLLAMA_KEEP_ALIVE=10m         # RAM 여유 많으면 -1, 빠듯하면 5m
# QDRANT_PATH=./data/qdrant

# ── 클라우드 Qdrant 를 쓰려면 (임베디드 대신) ─────────────────────
# QDRANT_URL=https://xxxx.qdrant.io:6333
# QDRANT_API_KEY=your-key
