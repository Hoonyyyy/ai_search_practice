# 로컬 스택 기본값은 .env 없이도 동작한다. 바꿀 때만 아래를 사용.

# ── 임베딩 (provider 선택) ───────────────────────────────────
# 로컬 Ollama (기본). 품질은 가장 좋으나 모델이 2GB 라 무료 호스팅엔 안 올라간다.
# EMBED_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# EMBED_MODEL=bge-m3            # nomic-embed-text 로 바꾸면 EMBED_DIM=768 도 같이
# EMBED_DIM=1024
# OLLAMA_KEEP_ALIVE=10m         # RAM 여유 많으면 -1, 빠듯하면 5m
#
# 클라우드 임베딩 (배포용). 업로드 20배 빠르고 Ollama 서버가 필요 없다.
# EMBED_PROVIDER=openai
# EMBED_API_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...          # https://platform.openai.com/api-keys (선불, 자동충전 끌 것)
# EMBED_CLOUD_MODEL=text-embedding-3-large   # 3-small 은 한국어에서 Recall 38.9% 로 무너진다
# EMBED_DIM=3072                # 3-large=3072 / 3-small=1536 — 틀리면 업로드가 통째로 실패
#
# EMBED_DIM 을 바꾸면 기존 벡터는 전부 무효다(Qdrant 는 생성 시 차원 고정).
# 컬렉션을 치우고 evals/reload_corpus.py 로 재적재해야 한다.

# ── LLM ─────────────────────────────────────────────────────
# LLM_PROVIDER=ollama           # 완전 로컬(느림, CPU)
# LLM_MODEL=qwen2.5:3b          #   더 빠르게 qwen2.5:1.5b / 더 좋게 qwen2.5:7b
#
# 클라우드로 빠르게 (권장, 이 PC는 GPU 없음):
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...          # https://console.groq.com/keys (무료)
# GROQ_MODEL=openai/gpt-oss-120b     # 또는 qwen/qwen3.8-27b (사용 가능 모델은 콘솔에서 확인)

# ── 검색 ────────────────────────────────────────────────────
# TOP_K=4
# FULL_CONTEXT_THRESHOLD=12     # 청크 수가 이하이면 검색 생략하고 전부 컨텍스트로

# ── 벡터 DB ─────────────────────────────────────────────────
# QDRANT_PATH=./data/qdrant
# QDRANT_URL=https://xxxx.qdrant.io:6333   # 설정 시 원격 Qdrant
# QDRANT_API_KEY=your-key

# ── CORS ────────────────────────────────────────────────────
# 브라우저가 /health 를 직접 불러 이 서버를 깨울 수 있게 허용할 출처(쉼표 구분, 끝에 / 없이).
# 배포: 프론트(Vercel) 주소. Render 안의 Spring 이 부르면 FastAPI 는 깨어나지 않는다(v4.23).
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
