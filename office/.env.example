# office/.env 로 복사해서 채우기. 이 파일(.env)은 절대 커밋 금지.

# 동료들의 두뇌
OFFICE_PROVIDER=groq            # groq(빠름, 무료 일일 토큰 한도) | ollama(로컬, 무료·무제한, 느림)

# provider=groq 일 때
GROQ_API_KEY=gsk_...
OFFICE_MODEL=openai/gpt-oss-20b

# provider=ollama 일 때 (rag_search 와 같은 로컬 Ollama 사용)
# OLLAMA_BASE_URL=http://localhost:11434
# OFFICE_OLLAMA_MODEL=qwen2.5:3b

OFFICE_PORT=8899
# rag_search 레포 루트. 비워두면 office/ 의 부모 디렉토리를 사용.
REPO_ROOT=
